# Local development defaults. Copy to .env and override only what you need.

# Electron development shell target. Vite defaults to port 1420 for this app.
ELECTRON_START_URL=http://127.0.0.1:1420

# Optional fixed bridge port. The app generates private control and asset tokens
# for every sidecar process; they are intentionally not configurable.
BRIDGE_PORT=8765

# Optional Droid CLI override. Leave blank to use PATH discovery.
DROID_PATH=

# Optional Factory API key for local Droid child processes.
# Never commit a real key.
FACTORY_API_KEY=

# Optional development overrides.
SIDECAR_ENTRY=
# Optional Electron profile directory override. Lets a second dev instance run
# beside your main one with its own localStorage and settings.
DROIDEX_USER_DATA_DIR=
# Keep hidden Browser sessions warm by default. Set a positive millisecond value
# to close inactive hidden views after that delay.
DROID_NATIVE_BROWSER_IDLE_MS=0
DROID_CONTROL_MAX_OPEN_CHILD_SESSIONS=4
DROID_CONTROL_BROWSER_NATIVE_TIMEOUT_MS=12000

# Platform variables used for CLI discovery. Normally inherit these from your shell.
# PATH=/usr/local/bin:/usr/bin:/bin
# PATHEXT=.COM;.EXE;.BAT;.CMD
# ComSpec=C:\Windows\System32\cmd.exe

# Local packaging (npm run dist:mac) is unsigned unless a Developer ID identity
# is available. Production CI sets DROIDEX_RELEASE_BUILD=1 and fails closed
# unless both signing and notarization credentials are present.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# CSC_LINK=<base64 Developer ID Application .p12>
# CSC_KEY_PASSWORD=
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# Or use App Store Connect API credentials for notarization.
# APPLE_API_KEY=<path or encoded .p8 value supported by electron-builder>
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
